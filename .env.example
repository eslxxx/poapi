# ============================================================
# JIANG Gateway v3.0 环境变量模板
# ============================================================
# 说明：这里全部只是「初始值」。部署后所有项都能在 /admin 网页
#       热改并即时生效，无需重新部署。
# 复制：cp .env.example .env  （.env 已在 .gitignore，不会入库）
# ============================================================

# ── 上游连接（网页里叫「连接 / 模型」页）──
UPSTREAM_API_KEY=sk-你的密钥
UPSTREAM_BASE=https://cli.999554.xyz/v1
UPSTREAM_MODEL=deepseek-v4.1-flash

# ── 鉴权 ──
# 客户端调用本网关所需 Token（Bearer）
# 生成：head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20
GATEWAY_TOKEN=jl_替换为随机串
# 管理台口令；不设则回退用 GATEWAY_TOKEN
# 访问：https://<域名>/admin?key=<ADMIN_TOKEN>
ADMIN_TOKEN=替换为管理台口令

# ── 人格注入 ──
INJECT_PERSONA=true
FORCE_MODEL=true
STRIP_REASONING=true

# ── 请求参数 ──
MAX_TOKENS_FLOOR=16384
DEFAULT_TEMPERATURE=0.9
DEFAULT_TOP_P=0.95
FREQ_PENALTY=0.3
PRES_PENALTY=0.2
FORCE_PENALTIES=true

# ── 高级 ──
REQUEST_TIMEOUT=600
TEST_TIMEOUT=60
SSE_HEARTBEAT_SEC=10
SPOOF_USER_AGENT=python-httpx/0.28.1
VERIFY_SSL=false
CORS_ORIGINS=*
LOGS_LIMIT=200
LOG_DETAIL_MAX=300

# ── 持久化 ──
# 网页改的配置存这里。Render 免费档磁盘临时，重启回落到上面的默认值。
STATE_PATH=/tmp/jiang_state.json
# 预设单独存
PRESETS_PATH=/tmp/jiang_state_presets.json

# ============================================================
# 可选：自定义人格（不填则用代码内置的 JIANG 人格）
# JIANG_SYSTEM_PROMPT=...
# JIANG_TAIL_ANCHOR=...
# ============================================================