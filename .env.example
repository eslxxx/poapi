# JIANG Gateway 环境变量模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）

# ── 上游连接（也可在 /admin 网页里随时热改） ──
UPSTREAM_API_KEY=sk-你的密钥
UPSTREAM_BASE=https://cli.999554.xyz/v1
UPSTREAM_MODEL=deepseek-v4.1-flash
# 上游已知可用模型：kimi-k3 / glm-5.3 / deepseek-v4.1-flash / glm-5.3-flash /
#                   kimi-k2.8 / qwen3.8-max / qwen3.8-flash / deepseek-v4-flash

# ── 网关鉴权 ──
# 客户端调用本网关所需的 Bearer Token
# 生成：head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20
GATEWAY_TOKEN=jl_替换为随机串
# 管理台口令；不设则回退用 GATEWAY_TOKEN
# 访问方式：https://<域名>/admin?key=<ADMIN_TOKEN>
ADMIN_TOKEN=替换为管理台口令

# ── 人格注入 ──
# 是否丢弃客户端 system 并强制注入 JIANG 人格（默认 true）
INJECT_PERSONA=true
# 是否强制覆盖客户端传来的 model（默认 true）
FORCE_MODEL=true
# 是否剥离 reasoning_content（默认 true）
STRIP_REASONING=true

# ── 请求参数 ──
MAX_TOKENS_FLOOR=16384
DEFAULT_TEMPERATURE=0.9
DEFAULT_TOP_P=0.95
FREQ_PENALTY=0.3
PRES_PENALTY=0.2

# ── 传输层 ──
# SSE 心跳秒数，规避 Cloudflare 100s 无数据 524（默认 10）
SSE_HEARTBEAT_SEC=10
SPOOF_USER_AGENT=python-httpx/0.28.1

# ── 持久化 ──
# 管理台改的配置存这里。注意 Render 免费档磁盘是临时的，
# 重启会丢，回落到环境变量默认值。
STATE_PATH=/tmp/jiang_state.json