# JIANG Gateway 环境变量模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）

# 必填：上游 API 密钥
UPSTREAM_API_KEY=sk-你的密钥

# 可选：上游地址（默认 https://cli.999554.xyz/v1）
UPSTREAM_BASE=https://cli.999554.xyz/v1

# 可选：模型名（默认 deepseek-v4.1-flash）
UPSTREAM_MODEL=deepseek-v4.1-flash

# 公网必填：客户端调用本网关所需的 Bearer Token
# 生成方式：head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20
GATEWAY_TOKEN=jl_替换为随机串

# 可选：SSE 心跳间隔（秒），默认 10；用于规避 Cloudflare 100s 无数据 524
SSE_HEARTBEAT_SEC=10
